import model sm #-ckm_no_b_mass

define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define q = u c d s b u~ c~ d~ s~ b~

generate p p > t t~ QED=0, (t > W+ b, W+ > l vl), (t~ > w- b~, W- > l- vl~) @0
add process p p > t t~ j QED=0, (t > W+ b, W+ > l vl), (t~ > w- b~, W- > l- vl~) @1
add process p p > t t~ j j QED=0, (t > W+ b, W+ > l vl), (t~ > w- b~, W- > l- vl~) @2

output _OUTDIR_ 

