import model sm-ckm_no_b_mass

define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~

define vec = w+ w-

generate p p > vec z , (vec > j j) , (z > j j)
add process p p > vec z j , (vec > j j) , (z > j j)
add process p p > vec z j j , (vec > j j) , (z > j j)

output _OUTDIR_
