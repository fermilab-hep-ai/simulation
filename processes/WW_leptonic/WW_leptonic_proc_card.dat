import model sm-ckm_no_b_mass

define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~

generate p p > w+ w- , (w+ > l+ vl) , (w- > l- vl~)
add process p p > w+ w- j , (w+ > l+ vl) , (w- > l- vl~)
add process p p > w+ w- j j , (w+ > l+ vl) , (w- > l- vl~)

output _OUTDIR_