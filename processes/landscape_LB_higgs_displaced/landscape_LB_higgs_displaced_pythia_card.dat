! ---------------------------------------------------------------------------
! AIDA-Scout S1b -- landscape scalar cascades, benchmark L-B-displaced
!
! h -> phi_i phi_j at the shipped lambda = 1e-4; same topology as L-B but 730x longer-lived scalars
!
! The hard process is NOT a Pythia process.  landscape.make_lhe writes an LHE
! file containing the fully decayed hidden-sector cascade -- N = 200 singlet
! scalars sharing one PDG id, each carrying its own mass and its own proper
! decay length -- and Pythia reads it with Beams:frameType = 4, showering and
! hadronising the Standard Model partons at the ends of the chains.
!
! Generated by landscape/make_processes.py -- edit that script, not this file.
! ---------------------------------------------------------------------------

Random:setSeed = on
Random:seed = NSEED
Main:numberOfEvents = NEVENTS

! No generator-level cuts of any kind are applied: these signals live entirely
! below the thresholds that a default cut set would impose (spec section 4).

Init:showChangedSettings = on
Init:showChangedParticleData = on
Next:numberCount = 500
Next:numberShowInfo = 0
Next:numberShowProcess = 1
Next:numberShowEvent = 0

! ---- Hard process: the LHE written by landscape.make_lhe -------------------
! run.sh substitutes _LHEFILE_ with the path it generated for this job.
Beams:LHEF = _LHEFILE_

! Hidden landscape scalar: one id for the whole spectrum, mass and
! proper lifetime supplied per particle by the LHE record.
9000006:new = phi phi 1 0 0 5.0 0.0 0.05 1000.0
9000006:mayDecay = off
9000006:isResonance = false

Beams:frameType = 4

! THIS ONE MATTERS.  setLifetime = 1 (Pythia's default) takes the
! decay times from VTIMUP, which is where this sample's displacement
! lives; setLifetime = 2 discards them and every hidden-scalar decay
! vertex collapses to the origin, silently making the sample prompt.
! Set explicitly rather than relied on.
LesHouches:setLifetime = 1

! The cascade is decayed in the LHE; let long-lived hadrons decay too.
ParticleDecays:limitTau0 = off
