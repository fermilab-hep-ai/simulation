import model sm-ckm_no_b_mass

define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define q = u c d s b u~ c~ d~ s~ b~
define v = w+ w-


generate p p > v , (v > q q)
add process p p > v j $$ t t~ h , (v > q q)
add process p p > v j j $$ t t~ h , (v > q q)






#generate p p > w+, (w+ > q q) @0
#add process p p > w+ j, (w+ > q q) @1
#add process p p > w+ j j, (w+ > q q)@2

#generate p p > w-, (w+ > q q) @3
#add process p p > w- j, (w+ > q q) @4
#add process p p > w- j j, (w+ > q q)@5


output _OUTDIR_ 
