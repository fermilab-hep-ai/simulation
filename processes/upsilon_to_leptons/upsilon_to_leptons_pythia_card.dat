! 3) Beam parameter settings. Values below agree with default ones.
Beams:idA = 2212                   ! first beam, p = 2212, pbar = -2212
Beams:idB = 2212                   ! second beam, p = 2212, pbar = -2212
Beams:eCM = 14000.                 ! CM energy of collision

Bottomonium:all    = on   ! 

553:onMode       = off       ! 
553:onIfMatch    = 11 -11    !
553:onIfMatch    = 13 -13    !
553:onIfMatch    = 15 -15    !

100553:onMode    = off
100553:onIfMatch = 11 -11
100553:onIfMatch = 13 -13
100553:onIfMatch = 15 -15

200553:onMode    = off
200553:onIfMatch = 11 -11
200553:onIfMatch = 13 -13
200553:onIfMatch = 15 -15

Random:setSeed = on
Random:seed = NSEED
Main:numberOfEvents = NEVENTS

! 2) Settings related to output in init(), next() and stat().
! Init:showChangedSettings = on      ! list changed settings
! Init:showChangedParticleData = off ! list changed particle data
Next:numberCount = 1             ! print message every n events
Next:numberShowInfo = 1            ! print event information n times
Next:numberShowProcess = 5000         ! print process record n times
Next:numberShowEvent   = 10
